{
  "info": {
    "_postman_id": "weathergpt-api-v3",
    "name": "WeatherGPT API",
    "description": "WeatherGPT — Weather Intelligence and Disaster Decision-Support Platform\nOrganization: Ministry of Earth Sciences (MoES) / India Meteorological Department (IMD)\nTheme: Disaster Management\n\nPhases implemented:\n- Phase 1: Real-time weather and forecasts\n- Phase 2: Natural-language weather queries\n- Phase 3: Extreme weather alert foundation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "location", "value": "Delhi", "type": "string" }
  ],
  "item": [
    {
      "name": "Phase 1 - Weather",
      "item": [
        {
          "name": "Current Weather",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/weather/current?location={{location}}",
            "description": "Get real-time weather conditions for a location.\nSet the {{location}} variable to the city you want (e.g. Mumbai, Chennai, Bengaluru)."
          }
        },
        {
          "name": "7-Day Forecast",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/weather/forecast?location={{location}}&days=7",
            "description": "Get a 7-day weather forecast for a location.\nSet the {{location}} variable to the city you want."
          }
        },
        {
          "name": "16-Day Forecast",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/weather/forecast?location={{location}}&days=16",
            "description": "Get a 16-day weather forecast for a location.\nSet the {{location}} variable to the city you want."
          }
        },
        {
          "name": "Missing Location - 400",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/weather/current",
            "description": "Should return 400 - location is required."
          }
        }
      ]
    },
    {
      "name": "Phase 2 - Natural Language Chat",
      "item": [
        {
          "name": "Will it rain tomorrow?",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/chat/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"Will it rain tomorrow in {{location}}?\"}" }
          }
        },
        {
          "name": "Weather this week",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/chat/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"What's the weather in {{location}} this week?\"}" }
          }
        },
        {
          "name": "Temperature query",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/chat/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"How hot will it be in {{location}} tomorrow?\"}" }
          }
        },
        {
          "name": "Unsupported query",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/chat/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"What is the capital of India?\"}" }
          }
        },
        {
          "name": "Missing location in message",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/chat/query",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"What is the weather?\"}" }
          }
        }
      ]
    },
    {
      "name": "Phase 3 - Extreme Weather Alerts",
      "item": [
        {
          "name": "Get Alerts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/alerts?location={{location}}",
            "description": "Get active extreme weather alerts for a location.\n\nExpected response includes:\n- officialProviderActive: false (no official provider configured yet)\n- providerStatus: message directing to mausam.imd.gov.in\n- alerts: [] (NoOpAlertProvider returns no fabricated alerts)\n\nSet the {{location}} variable to the city you want."
          }
        },
        {
          "name": "Missing Location (400)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/alerts",
            "description": "Should return 400 - location is required."
          }
        },
        {
          "name": "Unknown Location (404)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/alerts?location=UnknownCityXYZ123",
            "description": "Should return 404 - location not found."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@weathergpt.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"password\": \"Secure@1234\",\n  \"confirmPassword\": \"Secure@1234\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@weathergpt.com\",\n  \"password\": \"Secure@1234\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
